RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

echo "${YELLOW}Running lint-staged...${NC}"

npx lint-staged
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "${RED}🚫 Commit blocked due to Prettier/ESLint errors. Fix them first!${NC}"
  exit 1
fi

echo ""
echo "${GREEN}✅ Pre-commit checks passed. Commit allowed.${NC}"
